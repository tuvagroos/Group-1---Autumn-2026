<!DOCTYPE html>
<html lang="no" data-bs-theme="dark">
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Resq</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Resq.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body class="@(ViewData["FullWidth"] is true ? "full-width-page" : "")">
    <header class="topbar">
        <!-- Venstre område: logoen skal alltid være synlig og føre tilbake til kartet. -->
        <div class="topbar-brand">
            <a class="brand-name" asp-controller="Home" asp-action="Index">RESQ</a>
            <div class="brand-tagline">
            </div>
        </div>

        <!-- Navigasjonsområde: lenkene vises øverst på desktop og fast nederst på mobil. -->
        <nav id="main-navigation" class="topbar-nav" aria-label="Hovednavigasjon">
            <a asp-controller="Home" asp-action="Index"
               class="topbar-link @(controller == "Home" ? "active" : "")">
                <i class="bi bi-map topbar-link-icon" aria-hidden="true"></i>
                <span>Map</span>
            </a>
            <a asp-controller="Incidents" asp-action="Index"
               class="topbar-link @(controller == "Incidents" ? "active" : "")">
                <i class="bi bi-exclamation-triangle topbar-link-icon" aria-hidden="true"></i>
                <span>Incidents</span>
            </a>
            <a asp-controller="Resources" asp-action="Index"
               class="topbar-link @(controller == "Resources" ? "active" : "")">
                <i class="bi bi-box-seam topbar-link-icon" aria-hidden="true"></i>
                <span>Resources</span>
            </a>
            <a asp-controller="Reports" asp-action="Index"
               class="topbar-link @(controller == "Reports" ? "active" : "")">
                <i class="bi bi-bar-chart-line topbar-link-icon" aria-hidden="true"></i>
                <span>Reports</span>
            </a>
            <!-- Denne knappen åpner hendelsesskjemaet på mobil, mens sidepanelet allerede er synlig på desktop. -->
            <button id="new-incident-button" class="topbar-link panel-toggle incident-menu-button"
                    data-panel-toggle data-home-url="@Url.Action("Index", "Home")" type="button"
                    aria-controls="side-panel" aria-expanded="false">
                <i class="bi bi-plus-circle topbar-link-icon" aria-hidden="true"></i>
                <span>New incident</span>
            </button>
        </nav>

        <!-- Høyre område: her kan brukerrollen eller innlogget bruker vises. -->
        <div class="topbar-user">
            Resource provider
        </div>
    </header>
    <div class="container @(ViewData["FullWidth"] is true ? "container-full-width" : "")">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer"> @* // Endrer bunnen av nettsiden til å se lik ut som resten *@
        <div class="container">
            &copy; 2026 - Resq - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
